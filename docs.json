        "disable_summary_gen": true
      }
    },
    {
      "name": "doxygen_to_xml",
      "options": {
        "INPUT": "libraries/chain/include/upcxio/chain/webassembly/interface.hpp plugins/blockvault_client_plugin/include/upcxio/blockvault_client_plugin/blockvault.hpp"
      },
      "disable_default_filters": true,
      "filters": []
    },
    {
      "name": "doxybook",
      "options": {}
    }
  ]
}
