# Per-node nodupcx settings, installed as /etc/default/nodupcx.
# Every node has its own producer name — never run two nodes under the same one.

# UPCX_Main1 = upcx, UPCX_Main2 = upcx.a, ... Required.
NODUPCX_PRODUCER_NAME=upcx

# Space-separated host:port list, APPENDED to any p2p-peer-address already in config.ini.
# Leave empty when config.ini already lists the peers, or the node dials each one twice.
NODUPCX_P2P_PEERS=""

NODUPCX_BIN_DIR=/home/ubuntu/UPCX-Core/build/bin
NODUPCX_DATA_DIR=/root/.local/share/upcx/nodupcx/data
NODUPCX_CONFIG_DIR=/root/.local/share/upcx/nodupcx/config
NODUPCX_HTTP_SERVER_ADDRESS=0.0.0.0:8888

# Extra nodupcx flags, split on whitespace. Do NOT put -e / --enable-stale-production
# here: on a live multi-producer chain it lets a lagging node produce off the tip.
NODUPCX_EXTRA_ARGS=""

# Set to 1 only to deliberately bootstrap a node with no chain state.
NODUPCX_ALLOW_FRESH_CHAIN=0

# --hard-replay-blockchain after an unclean exit. Only ever attempted when blocks.log
# starts at genesis, and at most once per cooldown window.
NODUPCX_AUTO_REPLAY=1
NODUPCX_REPLAY_COOLDOWN_SEC=21600
